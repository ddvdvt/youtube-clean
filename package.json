{
  "name": "youtube-clean",
  "version": "1.0.0",
  "private": true,
  "description": "Видео без мусора: скрывает Shorts, рекомендации, автовоспроизведение и лишние блоки на YouTube",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:e2e": "node e2e/smoke.mjs",
    "locales": "node scripts/locales.src.mjs",
    "icons": "node scripts/make-icons.mjs",
    "zip": "node scripts/pack.mjs",
    "rules:sign": "node scripts/rules.mjs sign",
    "rules:verify": "node scripts/rules.mjs verify",
    "store:images": "node scripts/store-images.mjs",
    "zip:firefox": "node scripts/firefox.mjs",
    "lint:firefox": "node scripts/firefox.mjs && web-ext lint --source-dir dist/firefox",
    "test:e2e:firefox": "node e2e/firefox.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "puppeteer-core": "^25.16.0",
    "web-ext": "^10.8.0"
  }
}
